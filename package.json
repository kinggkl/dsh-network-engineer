    "skills/**",
    "kb/**",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "NOTICE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "network-engineer",
    "network",
    "huawei",
    "h3c",
    "ruijie",
    "dptech",
    "cisco",
    "nxos",
    "juniper",
    "arista",
    "fortinet",
    "zte",
    "vyos",
    "mikrotik",
    "routeros"
  ],
  "scripts": {
    "test": "node --test test/",
    "validate": "bash tools/kb-validate.sh kb"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinggkl/dsh-network-engineer.git"
  },
  "homepage": "https://github.com/kinggkl/dsh-network-engineer#readme",
